NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://videonova:videonova@localhost:5432/videonova?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
STORAGE_ROOT=./storage
FFMPEG_PATH=ffmpeg
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_VIDEO=10
VIDEO_CREDIT_COST=1
ADMIN_EMAIL=admin@videonova.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=VideoNova Admin
LOG_LEVEL=info
